{{if .Find}}
const maxPageSize = 100

var allowedFindFields = map[string]struct{}{
{{range .FindFields}}
	"{{.}}": {},
{{end}}
}

var findFieldNames = []string{
{{range .FindFields}}
	"{{.}}",
{{end}}
}
{{end}}

