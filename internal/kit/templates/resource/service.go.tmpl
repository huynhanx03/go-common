{{if .Find}}
func (service *Service) Find(ctx context.Context, input FindInput) (*dto.Paginated[Model], error) {
	pagination := dto.PaginationOptions{}
	if input.Pagination != nil {
		pagination.Page = input.Pagination.Page
		pagination.PageSize = input.Pagination.PageSize
	}
	if pagination.Page < 0 || pagination.PageSize < 0 {
		return nil, invalidInput("page and page_size must be positive")
	}
	pagination.SetDefaults()
	if pagination.PageSize > maxPageSize {
		return nil, invalidInput(fmt.Sprintf("page_size must not exceed %d", maxPageSize))
	}
	if _, err := pagination.Offset(); err != nil {
		return nil, invalidInput("invalid pagination")
	}
	for _, filter := range input.Filters {
		if _, ok := allowedFindFields[filter.Key]; !ok {
			return nil, invalidInput(fmt.Sprintf("filter field %q is not supported", filter.Key))
		}
	}
	sorts := append([]dto.SortOption(nil), input.Sort...)
	hasIDSort := false
	for _, sort := range sorts {
		if _, ok := allowedFindFields[sort.Key]; !ok {
			return nil, invalidInput(fmt.Sprintf("sort field %q is not supported", sort.Key))
		}
		if sort.Order != -1 && sort.Order != 1 {
			return nil, invalidInput("sort order must be 1 or -1")
		}
		hasIDSort = hasIDSort || sort.Key == "id"
	}
	if !hasIDSort {
		sorts = append(sorts, dto.SortOption{Key: "id", Order: -1})
	}
	options := &dto.QueryOptions{Pagination: &pagination, Filters: input.Filters, Sort: sorts}
	rows, count, err := service.repository.Find(ctx, options)
	if err != nil {
		return nil, commonent.MapEntError(err, "{{.Name}}")
	}
	metadata, err := dto.CalculatePaginationChecked(pagination.Page, pagination.PageSize, int64(count))
	if err != nil {
		return nil, invalidInput("invalid pagination result")
	}
	records := make([]Model, len(rows))
	for index, row := range rows {
		records[index] = modelFromEntity(row)
	}
	return &dto.Paginated[Model]{Records: &records, Pagination: metadata}, nil
}
{{end}}

{{if .Get}}
func (service *Service) Get(ctx context.Context, id uuid.UUID) (Model, error) {
	row, err := service.repository.Get(ctx, id)
	if err != nil {
		return Model{}, commonent.MapEntError(err, "{{.Name}}")
	}
	return modelFromEntity(row), nil
}
{{end}}

