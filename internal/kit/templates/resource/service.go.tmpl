{{if .GetBulk}}
func (service *Service) GetBulk(ctx context.Context, ids []uuid.UUID) ([]Model, error) {
	if err := validateBulkIDs(ids, service.config.MaxBulkSize); err != nil {
		return nil, err
	}
	rows, err := service.repository.GetBulk(ctx, ids)
	if err != nil {
		return nil, commonent.MapEntError(err, "{{.Name}}")
	}
	return modelsFromEntities(rows), nil
}
{{end}}

{{if .CreateBulk}}
func (service *Service) CreateBulk(ctx context.Context, items []CreateInput) ([]Model, error) {
	if err := validateBulkSize(len(items), service.config.MaxBulkSize); err != nil {
		return nil, err
	}
	for _, item := range items {
		if err := validateCreate(item); err != nil {
			return nil, err
		}
	}
	rows, err := service.repository.CreateBulk(ctx, items)
	if err != nil {
		return nil, commonent.MapEntError(err, "{{.Name}}")
	}
	return modelsFromEntities(rows), nil
}
{{end}}

{{if .UpdateBulk}}
func (service *Service) UpdateBulk(ctx context.Context, items []UpdateItem) ([]Model, error) {
	if err := validateBulkSize(len(items), service.config.MaxBulkSize); err != nil {
		return nil, err
	}
	ids := make([]uuid.UUID, len(items))
	for index, item := range items {
		ids[index] = item.ID
		if err := validateUpdate(item.Changes); err != nil {
			return nil, err
		}
	}
	if err := validateUniqueIDs(ids); err != nil {
		return nil, err
	}
	rows, err := service.repository.UpdateBulk(ctx, items)
	if err != nil {
		return nil, commonent.MapEntError(err, "{{.Name}}")
	}
	return modelsFromEntities(rows), nil
}
{{end}}

{{if .UpsertBulk}}
func (service *Service) UpsertBulk(ctx context.Context, items []UpsertInput) ([]Model, error) {
	if err := validateBulkSize(len(items), service.config.MaxBulkSize); err != nil {
		return nil, err
	}
	ids := make([]uuid.UUID, len(items))
	for index, item := range items {
		ids[index] = item.ID
	}
	if err := validateUniqueIDs(ids); err != nil {
		return nil, err
	}
	rows, err := service.repository.UpsertBulk(ctx, items)
	if err != nil {
		return nil, commonent.MapEntError(err, "{{.Name}}")
	}
	return modelsFromEntities(rows), nil
}
{{end}}

{{if .DeleteBulk}}
func (service *Service) DeleteBulk(ctx context.Context, ids []uuid.UUID) error {
	if err := validateBulkIDs(ids, service.config.MaxBulkSize); err != nil {
		return err
	}
	if err := service.repository.DeleteBulk(ctx, ids); err != nil {
		return commonent.MapEntError(err, "{{.Name}}")
	}
	return nil
}
{{end}}

{{if or .Create .CreateBulk}}
func validateCreate(CreateInput) error { return nil }
{{end}}

{{if or .Update .UpdateBulk}}
func validateUpdate(UpdateInput) error {
	return invalidInput("update requires at least one editable field")
}
{{end}}

{{if or .GetBulk .CreateBulk .UpdateBulk .UpsertBulk .DeleteBulk}}
func validateBulkSize(size, maximum int) error {
	if size < 1 || size > maximum {
		return invalidInput(fmt.Sprintf("bulk size must be between 1 and %d", maximum))
	}
	return nil
}

func validateBulkIDs(ids []uuid.UUID, maximum int) error {
	if err := validateBulkSize(len(ids), maximum); err != nil {
		return err
	}
	return validateUniqueIDs(ids)
}

func validateUniqueIDs(ids []uuid.UUID) error {
	seen := make(map[uuid.UUID]struct{}, len(ids))
	for _, id := range ids {
		if id == uuid.Nil {
			return invalidInput("bulk IDs must not be empty")
		}
		if _, exists := seen[id]; exists {
			return invalidInput("bulk IDs must be unique")
		}
		seen[id] = struct{}{}
	}
	return nil
}

func modelsFromEntities(rows []*genent.{{.TypeName}}) []Model {
	models := make([]Model, len(rows))
	for index, row := range rows {
		models[index] = modelFromEntity(row)
	}
	return models
}
{{end}}

{{if or .Find .Update .Upsert .GetBulk .CreateBulk .UpdateBulk .UpsertBulk .DeleteBulk}}
func invalidInput(message string) error {
	return apperr.New(apperr.CodeValidationFailed, message, nil)
}
{{end}}

func modelFromEntity(row *genent.{{.TypeName}}) Model {
	model := Model{ID: row.ID, CreatedAt: row.CreatedAt, UpdatedAt: row.UpdatedAt}
{{if .SoftDelete}}
	model.DeletedAt = row.DeletedAt
	model.DeletedBy = row.DeletedBy
{{end}}
{{if .Modifier}}
	model.CreatedBy = row.CreatedBy
	model.UpdatedBy = row.UpdatedBy
{{end}}
	return model
}
